    "Dishes show only their name when this is off. Nothing is generated, and anything generated before stays hidden." : {
      "comment" : "Explains what turning off the Apple Intelligence content switch in Settings does.",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan està desactivat, els plats només mostren el nom. No es genera res, i el que s'hagi generat abans queda amagat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivado, los platos solo muestran su nombre. No se genera nada, y lo generado anteriormente queda oculto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque cette option est désactivée, les plats n'affichent que leur nom. Rien n'est généré, et ce qui a été généré auparavant reste masqué."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cando está desactivado, os pratos só amosan o seu nome. Non se xera nada, e o xerado anteriormente queda agochado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando è disattivato, i piatti mostrano solo il loro nome. Non viene generato nulla e ciò che è stato generato in precedenza resta nascosto."
          }
        }
      }
    },
    "Generated descriptions and images" : {
      "comment" : "Label of the Settings switch that turns Apple Intelligence descriptions and illustrations on or off.",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descripcions i imatges generades"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descripciones e imágenes generadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descriptions et images générées"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descricións e imaxes xeradas"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrizioni e immagini generate"
          }
        }
      }
    },
    "Removes every description and illustration saved on this device." : {
      "comment" : "Explains what the delete button in Settings removes.",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina totes les descripcions i il·lustracions desades en aquest dispositiu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas las descripciones e ilustraciones guardadas en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime toutes les descriptions et illustrations enregistrées sur cet appareil."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas as descricións e ilustracións gardadas neste dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tutte le descrizioni e le illustrazioni salvate su questo dispositivo."
          }
        }
      }
    },
